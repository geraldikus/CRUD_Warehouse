# Used by docker compose to create the Postgres role and database.
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse

# Used by the API and by SQLx at compile time (query_as! checks SQL against this DB).
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse

# Used only by integration tests. Created by docker/init-test-db.sql.
TEST_DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse_test

# MQTT broker (Mosquitto). The API still starts if this broker is down.
MQTT_HOST=localhost
MQTT_PORT=1883

# Desktop window (`cargo run -p warehouse-desktop`), from the repo root.
# Unset means http://localhost:3000. MQTT_HOST and MQTT_PORT above are shared.
WAREHOUSE_API_URL=http://localhost:3000

# Optional. Shrink expiry warnings for a demo (defaults: 86400, 3600, 60).
# EXPIRY_DAY_SECS=120
# EXPIRY_HOUR_SECS=60
# EXPIRY_TICK_SECS=5

# Groq assistant. Leave the key empty to run without it: POST /assistant
# returns 503, and the rest of the API still works. Put the real key in `.env`
# only. The desktop window never sees it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local speech sidecar (Vosk, Piper, Silero), started by docker compose.
# The first `docker compose up` downloads the models into a volume.
# Set this to empty to turn speech routes off: they answer 503.
VOICE_URL=http://localhost:8000
