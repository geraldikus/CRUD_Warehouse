# Used by docker compose to create the Postgres role and database.
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse

# Used by the API and by SQLx at compile time (query_as! checks SQL against this DB).
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse

# Used only by integration tests. Created by docker/init-test-db.sql.
TEST_DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse_test
