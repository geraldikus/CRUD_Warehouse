  "query": "\n        UPDATE items\n        SET quantity = quantity + $1,\n            updated_at = now()\n        WHERE id = $2\n          AND quantity <= 2147483647 - $1\n        RETURNING id, name, quantity, created_at, updated_at, expires_at\n        ",
